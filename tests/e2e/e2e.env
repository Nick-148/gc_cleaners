# Environment for the Playwright run (`npm run test:e2e`). Local-only test values; nothing here is secret.
ENVIRONMENT=development
# Cloudflare's documented always-pass Turnstile secret (pairs with the default test site key).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Local admin bypass, honored only because ENVIRONMENT=development (ADR 0005).
DEV_ADMIN_EMAIL=admin@example.com
NOTIFY_EMAIL=owner@example.com
RATE_LIMIT_SALT=e2e-salt
