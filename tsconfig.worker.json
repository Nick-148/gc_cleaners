{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    "src/server/**/*",
    "src/shared/**/*",
    "src/config/**/*",
    "src/content/**/*",
    "functions/**/*",
    "tests/unit/**/*",
    "tests/integration/**/*"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
