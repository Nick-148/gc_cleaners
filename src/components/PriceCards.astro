---
import { packages } from '../config/site';
import { formatUsd } from '../shared/money';

interface Props {
  /** Show the full "what's included" list (Services page) or just the summary (Home). */
  detailed?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { detailed = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ul class="price-cards" role="list">
  {packages.map((pkg) => (
    <li class:list={['price-card', { 'price-card--featured': pkg.id === 'bundle' }]}>
      {pkg.id === 'bundle' && <span class="price-card__flag">Best value</span>}
      <Heading class="price-card__name">{pkg.name}</Heading>
      <p class="price-card__price">
        <span class="price-card__amount">{formatUsd(pkg.priceCents)}</span>
        <span class="muted small">per visit</span>
      </p>
      <p class="price-card__summary">{pkg.summary}</p>
      <p class="small muted price-card__duration">{pkg.duration}</p>
      {detailed && (
        <ul class="check-list small">
          {pkg.includes.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
      {pkg.requiresPrivateBathroom && (
        <p class="small muted">For suite and apartment bathrooms only.</p>
      )}
      <a
        class:list={['btn', 'btn--block', { 'btn--secondary': pkg.id !== 'bundle' }]}
        href={`/book?package=${pkg.id}`}
      >
        Book {pkg.name}
      </a>
    </li>
  ))}
</ul>

<style>
  .price-cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 860px) {
    .price-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }
  .price-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .price-card--featured {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }
  .price-card__flag {
    position: absolute;
    top: -0.8rem;
    left: var(--space-5);
    padding: 0.2rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .price-card__name {
    margin: 0;
    font-size: var(--text-lg);
  }
  .price-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
  }
  .price-card__amount {
    font-size: 2.6rem;
    font-weight: 850;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }
  .price-card__summary {
    margin: 0;
  }
  .price-card__duration {
    margin: 0 0 var(--space-2);
  }
  .price-card .btn {
    margin-top: auto;
  }
  .price-card .check-list {
    margin-bottom: var(--space-3);
  }
</style>
