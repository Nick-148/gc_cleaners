---
import AdminApp from '../../components/islands/admin/AdminApp';
import Logo from '../../components/Logo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<!-- Protected by Cloudflare Access at the edge and verified again by the API (ADR 0005). -->
<BaseLayout title="Admin" noindex bare>
  <header class="admin-header">
    <div class="container admin-header__inner">
      <Logo />
      <span class="badge">Admin</span>
      <a class="small admin-header__site" href="/">
        View site
      </a>
    </div>
  </header>
  <div class="container admin-container">
    <h1 class="visually-hidden">Admin dashboard</h1>
    <AdminApp client:only="preact">
      <p slot="fallback" class="muted">
        Loading dashboard…
      </p>
    </AdminApp>
  </div>
</BaseLayout>

<style is:global>
  .admin-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .admin-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
  }
  .admin-header__site {
    margin-left: auto;
  }
  .admin-container {
    padding-block: var(--space-5) var(--space-7);
  }
  .admin-shell {
    display: grid;
    gap: var(--space-5);
  }
  .admin-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .admin-top p {
    margin: 0;
  }
  .admin-stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
  }
  .admin-stats li {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .admin-stats__num {
    font-weight: 850;
  }
  .admin-tabs {
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    border-bottom: 2px solid var(--color-border);
  }
  .admin-tabs a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    color: var(--color-muted);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .admin-tabs a[aria-current='page'] {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }
  .admin-tabs__count {
    min-width: 1.5rem;
    padding: 0 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: var(--text-xs);
    text-align: center;
  }
  .admin-panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .admin-panel-head h2 {
    margin: 0;
  }
  .admin-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .admin-filter-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-muted);
  }
  .admin-filters .select {
    min-height: 40px;
    width: auto;
  }
  .admin-day h3 {
    margin: var(--space-5) 0 var(--space-3);
    font-size: var(--text-base);
    color: var(--color-muted);
  }
  .admin-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .admin-card {
    display: grid;
    gap: var(--space-3);
  }
  .admin-card p,
  .admin-card h4 {
    margin: 0;
  }
  .admin-card h4 {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .admin-card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .admin-card__title {
    font-weight: 800;
    text-transform: capitalize;
  }
  .admin-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    font-size: var(--text-sm);
  }
  .admin-meta dt {
    color: var(--color-muted);
  }
  .admin-meta dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .admin-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .admin-notes .btn {
    justify-self: start;
  }
  .admin-stack {
    display: grid;
    gap: var(--space-5);
  }
  .admin-stack h3 {
    margin-bottom: var(--space-2);
  }
  .admin-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .admin-row__label {
    flex: 1 1 200px;
    font-weight: 600;
  }
  .admin-inline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .input--tiny {
    width: 4.5rem;
    min-height: 38px;
    padding: var(--space-1) var(--space-2);
  }
  .admin-add {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
    justify-items: start;
  }
  .admin-add h4 {
    margin: 0;
  }
  .admin-add__fields {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    width: 100%;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .admin-table th,
  .admin-table td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .admin-table tr.is-over {
    background: var(--color-danger-soft);
  }
  .admin-table tr.is-closed {
    color: var(--color-muted);
  }
  .table-scroll {
    overflow-x: auto;
  }
  .admin-photos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: var(--space-2);
    padding: 0;
    margin: 0;
  }
  .admin-photos img,
  .admin-photos .photo-placeholder {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: var(--text-xs);
    text-align: center;
    padding: var(--space-2);
  }
  .status {
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }
  .status--pending,
  .status--new {
    background: var(--color-accent-soft);
  }
  .status--confirmed,
  .status--quoted,
  .status--interviewing {
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  .status--completed,
  .status--hired,
  .status--handled,
  .status--booked {
    background: var(--color-success-soft);
    color: var(--color-success);
  }
  .status--cancelled,
  .status--no_show,
  .status--declined {
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }
  .mono {
    font-family: var(--font-mono);
  }
  .prewrap {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .admin-toast-region {
    position: fixed;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: min(92vw, 420px);
  }
  .admin-toast {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-weight: 700;
    background: var(--color-success-soft);
    border: 1px solid var(--color-success);
  }
  .admin-toast--error {
    background: var(--color-danger-soft);
    border-color: var(--color-danger);
  }
</style>
